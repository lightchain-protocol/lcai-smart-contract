# LCAI DAO Smart Contract Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to git!

# =============================================================================
# REQUIRED: Deployment Wallet Private Key
# =============================================================================
# Your wallet private key for contract deployments
# Used for: lcaiTestnet and lcai_testnet_v2 network deployments
# Format: 0x followed by 64 hex characters
OWNER_WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# =============================================================================
# OPTIONAL: Network RPC URLs
# =============================================================================
# These have defaults but can be overridden per environment

# LCAI Testnet RPC
# Default: https://light-testnet-rpc.lightchain.ai
LCAI_TESTNET_RPC_URL=https://light-testnet-rpc.lightchain.ai

# LCAI Testnet v2 RPC
# Default: http://localhost:8545 (set to your remote RPC when applicable)
LCAI_TESTNET_V2_RPC_URL=http://localhost:8545
LCAI_TESTNET_V2_CHAIN_ID=504

# Blockscout configuration (used for verification and explorer links)
LCAI_BLOCKSCOUT_BROWSER_URL=http://localhost:4000
LCAI_BLOCKSCOUT_API_URL=http://localhost:4000/api
LCAI_BLOCKSCOUT_NAME=Lightchain v2 Blockscout

# Sepolia Testnet RPC
# Default: https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# =============================================================================
# OPTIONAL: Sepolia Deployment Key
# =============================================================================
# Only needed if deploying to Sepolia testnet
# Alternative: Use 'npx hardhat keystore set SEPOLIA_PRIVATE_KEY' for encrypted storage
SEPOLIA_PRIVATE_KEY=0xYOUR_SEPOLIA_PRIVATE_KEY_HERE

# =============================================================================
# OPTIONAL: Stored Contract Addresses (populated by deploy scripts)
# =============================================================================
# The deploy scripts automatically update these values in your local .env when
# running against lcai_testnet_v2. Provide placeholders here for new setups.
LCAI_TESTNET_V2_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000
LCAI_TESTNET_V2_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
LCAI_TESTNET_V2_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
LCAI_TESTNET_V2_CHAT_UTILITY_ADDRESS=0x0000000000000000000000000000000000000000
LCAI_TESTNET_V2_CHAT_SUBSCRIPTION_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
# 1. Never share your private keys
# 2. Use different wallets for development and production
# 3. Consider using hardware wallets for production deployments
# 4. Use hardhat-keystore for encrypted key storage
# 5. Regularly rotate development keys
# 6. Keep this file in .gitignore (already configured)
